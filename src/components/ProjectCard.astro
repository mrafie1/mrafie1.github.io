---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="project-card">
  <div class="card-header">
    <div class="card-title">
      <span class="title-icon"></span>
      <span>{title}</span>
    </div>

    <div class="carousel-controls">
      <button
        class="carousel-button"
        type="button"
        data-direction="left"
        aria-label="Scroll left"
      >
        ‹
      </button>

      <button
        class="carousel-button"
        type="button"
        data-direction="right"
        aria-label="Scroll right"
      >
        ›
      </button>
    </div>
  </div>

  <div class="carousel-body">
    <div class="project-track">
      <slot />
    </div>
  </div>
</section>

<script>
  document.querySelectorAll(".project-card").forEach((card) => {
    const track = card.querySelector(".project-track");

    const leftButton = card.querySelector('[data-direction="left"]');

    const rightButton = card.querySelector('[data-direction="right"]');

    if (!track || !leftButton || !rightButton) return;

    const scrollAmount = 400;

    leftButton.addEventListener("click", () => {
      track.scrollBy({
        left: -scrollAmount,
        behavior: "smooth",
      });
    });

    rightButton.addEventListener("click", () => {
      track.scrollBy({
        left: scrollAmount,
        behavior: "smooth",
      });
    });
  });
</script>

<style>
  .project-card {
    width: min(90%, 700px);
    margin: 0 auto;

    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;

    background-color: var(--DarkGreenBG);
    border: 1px solid var(--BorderDark);

    box-shadow:
      inset 1px 1px 0 var(--BorderBright),
      inset -1px -1px 0 var(--BorderDark);

    font-family: Arial, Helvetica, sans-serif;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 7px 10px;

    background-color: var(--GreenBG);
    border-bottom: 1px solid var(--BorderDark);

    box-shadow:
      inset 1px 1px 0 rgba(216, 222, 211, 0.2),
      inset -1px -1px 0 rgba(40, 46, 34, 0.7);
  }

  .card-title {
    display: flex;
    align-items: center;
    gap: 8px;

    color: var(--OffWhite);

    font-size: 13px;
    font-weight: bold;
    text-transform: uppercase;
  }

  .title-icon {
    display: inline-block;

    width: 7px;
    height: 7px;

    background-color: var(--Maize);

    border: 1px solid var(--BorderDark);

    box-shadow:
      inset 1px 1px 0 var(--OffWhite),
      inset -1px -1px 0 var(--MaizeBG);
  }

  .carousel-controls {
    display: flex;
    gap: 3px;
  }

  .carousel-button {
    width: 27px;
    height: 23px;

    padding: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    background-color: var(--DarkGreenBG);
    color: var(--OffWhite);

    border: 1px solid var(--BorderDark);

    box-shadow:
      inset 1px 1px 0 var(--BorderBright),
      inset -1px -1px 0 var(--BorderDark);

    font-family: Arial, Helvetica, sans-serif;
    font-size: 20px;
    line-height: 1;

    cursor: pointer;
  }

  .carousel-button:hover {
    background-color: var(--LightGreenBG);
  }

  .carousel-button:active {
    box-shadow:
      inset 1px 1px 0 var(--BorderDark),
      inset -1px -1px 0 var(--BorderBright);

    transform: translate(1px, 1px);
  }

  .carousel-body {
    padding: 12px;

    overflow: hidden;
  }

  .project-track {
    display: flex;
    gap: 10px;

    overflow-x: auto;
    overflow-y: hidden;

    scroll-behavior: smooth;
    scroll-snap-type: x proximity;

    scrollbar-width: none;

    padding-bottom: 2px;
  }

  .project-track::-webkit-scrollbar {
    display: none;
  }

  .project-track > * {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }
</style>
