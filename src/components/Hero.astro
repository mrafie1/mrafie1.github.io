---
import Face from "./Face.astro";
import ContextBox from "./ContentBox.astro";

import { getCollection } from "astro:content";
const allPosts = await getCollection("blog");
---

<header>
  <h1>hi, i'm muhammad</h1>
</header>

<Face />

<main>
  <hr class="dotted-divider" />

  <div class="text-block">
    <p>i'm a computer science student at the university of toronto.</p>
    <p>
      i love software design, cybersecurity, computers, networks, and making
      random fun tools :)
    </p>
  </div>

  <hr class="dotted-divider" />

  <div class="context-boxes">
    <div class="context-top">
      <ContextBox name="Now">
        <p>working on super cool projects, stay tuned :)</p>
      </ContextBox>

      <ContextBox name="What I've done" lined={true}>
        <p>software engineer on the IQBank team</p>
        <p>contributing to MarkUs, an open-source project used by thousands of students, as a student developer </p>
      </ContextBox>
    </div>

    <ContextBox name="What's New" lined={true} `>
      {
        allPosts.map((post) => {
          return (
            <a class="post-link" href={`/blog/${post.id}/`}>
              <span class="post-title">{post.data.title}</span>

              <span class="post-date">
                {post.data.pubDate.toLocaleDateString("en-CA", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </span>
            </a>
          );
        })
      }
    </ContextBox>
  </div>
</main>

<style>
  header {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 2rem 0;
  }

  header h1 {
    margin: 0;
    color: var(--OffWhite);
  }

  main {
    width: min(90%, 700px);
    margin: 0 auto;
  }

  .dotted-divider {
    border: 0;
    border-top: 1px dotted #808080;
    margin: 0.75rem 0;
  }

  .text-block {
    text-align: center;
    padding: 0.25rem 0;
  }

  .text-block p {
    margin: 0.75rem 0;
    line-height: 1.6;
    color: var(--OffWhite);
  }

  .context-boxes {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
  }

  .context-top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    align-items: start;
  }
  .post-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;

    width: 100%;
    box-sizing: border-box;

    padding: 0;

    color: var(--OffWhite);

    font-size: 14px;

    text-decoration: none;
  }

  .post-title {
    min-width: 0;

    color: var(--OffWhite);

    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .post-date {
    margin-left: 2rem;

    color: var(--Label);

    font-size: 12px;

    white-space: nowrap;
    text-align: right;
  }

  .post-link:hover {
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 3px;
  }

  .post-link:hover .post-title {
    color: var(--OffWhite);
  }

  .post-link:hover .post-date {
    color: var(--Label);
  }

  .post-link:visited {
    color: var(--OffWhite);
  }

  @media (max-width: 600px) {
    .post-link {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .post-date {
      margin-left: 1rem;
      font-size: 11px;
    }

    .post-title {
      line-height: 1.4;
    }
  }
</style>
