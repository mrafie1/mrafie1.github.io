---
import ContextBox from "./ContentBox.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
---

<main>
  <div class="context-boxes">
    <ContextBox name="blog" lined={true}>
      {allPosts.map((post) => {
        return (
          <a
            class="post-link"
            href={`/blog/${post.id}/`}
          >
            <span class="post-title">
              {post.data.title}
            </span>

            <span class="post-date">
              {post.data.pubDate.toLocaleDateString("en-CA", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </span>
          </a>
        );
      })}
    </ContextBox>
  </div>
</main>

<style>
  main {
    width: min(90%, 700px);
    margin: 0 auto;
  }

  .context-boxes {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
  }

  .post-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;

    width: 100%;
    box-sizing: border-box;

    padding: 0;

    color: var(--OffWhite);

    font-size: 14px;

    text-decoration: none;
  }

  .post-title {
    min-width: 0;

    color: var(--OffWhite);

    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .post-date {
    margin-left: 2rem;

    color: var(--Label);

    font-size: 12px;

    white-space: nowrap;
    text-align: right;
  }

  .post-link:hover {
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 3px;
  }

  .post-link:hover .post-title {
    color: var(--OffWhite);
  }

  .post-link:hover .post-date {
    color: var(--Label);
  }

  .post-link:visited {
    color: var(--OffWhite);
  }

  @media (max-width: 600px) {
    .post-link {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .post-date {
      margin-left: 1rem;
      font-size: 11px;
    }

    .post-title {
      line-height: 1.4;
    }
  }
</style>