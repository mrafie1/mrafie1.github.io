---
import { Image } from 'astro:assets';

interface Props {
  id: string;
  title: string;
  image?: ImageMetadata;
}

const { id, title, image } = Astro.props;
---

<button
  class="project"
  type="button"
  data-project-id={id}
  aria-label={`View ${title}`}
>
  <div class="project-image">
    {image && (
      <Image
        src={image}
        alt={title}
        loading="lazy"
      />
    )}
  </div>

  <div class="project-title">
    {title}
  </div>
</button>

<script>
  document
    .querySelectorAll<HTMLButtonElement>("[data-project-id]")
    .forEach((project) => {
      project.addEventListener("click", () => {
        const id = project.dataset.projectId;

        if (!id) return;

        document.dispatchEvent(
          new CustomEvent("open-project-preview", {
            detail: { id },
          }),
        );
      });
    });
</script>

<style>
  .project {
    flex: 0 0 180px;
    width: 180px;

    padding: 0;

    display: block;
    box-sizing: border-box;

    background-color: var(--DarkGreenBG);
    border: 1px solid var(--BorderDark);

    color: var(--OffWhite);
    text-align: left;

    box-shadow:
      inset 1px 1px 0 var(--BorderBright),
      inset -1px -1px 0 var(--BorderDark);

    cursor: pointer;

    transition:
      transform 0.12s ease,
      border-color 0.12s ease;
  }

  .project:hover {
    transform: translateY(-2px);
    border-color: var(--BorderBright);
  }

  .project:active {
    transform: translateY(0);
  }

  .project-image {
    width: 100%;
    aspect-ratio: 16 / 9;

    overflow: hidden;

    background-color: #252b20;
  }

  .project-image img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  .project-title {
    padding: 9px 10px;

    color: var(--OffWhite);

    font-size: 13px;
    font-weight: bold;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
